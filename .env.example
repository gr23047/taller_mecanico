# Copia este archivo a .env y cambia los valores
COUCHDB_USER=admin
COUCHDB_PASSWORD=cambia_esto

# Puertos en tu PC (el CouchDB nativo sigue en 5984)
COUCHDB_HOST_PORT=5985
API_HOST_PORT=8090

# Mínimo 16 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
